{
  // Worker name is fixed by poietic-dot-tech infra/meetings.tf (project-site
  // module: poietic-<subdomain>). OpenTofu owns the Worker's existence, DNS
  // and route; this repo owns what it serves.
  "name": "poietic-meetings",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },

  // Routing stays in OpenTofu (meetings.poietic.tech/*); don't let wrangler
  // create a workers.dev URL or its own routes.
  "workers_dev": false,

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash"
  },

  // Public keys come from poietic-auth over a service binding, NOT a fetch
  // to https://auth.poietic.tech: a Worker's subrequest to another hostname
  // in the same zone skips that hostname's Worker route and hits the
  // placeholder origin (192.0.2.1), so the fetch fails. The site Worker in
  // poietic-dot-tech hit the same thing; see its wrangler.jsonc.
  "services": [{ "binding": "AUTH", "service": "poietic-auth" }],

  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]

  // Secrets (set by CI with `wrangler secret put`, never committed):
  //   CF_TURN_KEY_ID, CF_TURN_KEY_API_TOKEN
}
