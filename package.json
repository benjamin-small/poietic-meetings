{
  "name": "poietic-meetings",
  "version": "1.0.0",
  "scripts": {
    "test": "npm run check:client && vitest run && vitest run --config vitest.client.config.ts",
    "dev": "wrangler dev",
    "typecheck": "tsc",
    "deploy": "wrangler deploy",
    "types": "wrangler types --include-runtime=false",
    "check:client": "for f in public/*.js; do node --check \"$f\" || exit 1; done",
    "coverage": "vitest run --coverage && vitest run --config vitest.client.config.ts --coverage"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260930.2",
    "@vitest/coverage-istanbul": "^4.1.11",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.144.0"
  },
  "type": "module",
  "private": true,
  "description": "Meetings: group WebRTC video chat (up to 6) at meetings.poietic.tech",
  "engines": {
    "node": ">=24"
  },
  "license": "MIT"
}
